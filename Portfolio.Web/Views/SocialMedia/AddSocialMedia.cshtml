@model SocialMedia
@{
    ViewData["Title"] = "Sosyal Medya Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h2>Yeni Sosyal Medya Ekle</h2>

<form asp-action="AddSocialMedia" method="post">
    <div class="form-group mb-3">
        <label>Github</label>
        <input asp-for="GithubUrl" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label>Linkedin</label>
        <input asp-for="LinkedInUrl" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label>İnstagram</label>
        <input asp-for="InstagramUrl" class="form-control"  />
       
    </div>
    <div class="form-group mb-3">
        <label>Durum</label>
        <select asp-for="IsActive" class="form-control">
            <option value="true">Aktif</option>
            <option value="false">Pasif</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Geri</a>
</form>

