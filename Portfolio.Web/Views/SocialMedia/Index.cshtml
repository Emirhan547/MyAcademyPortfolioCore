@model List<SocialMedia>
@{
    ViewData["Title"] = "Sosyal Medya";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<h2>Sosyal Medya Hesapları</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Github Hesabı</th>
            <th>Linkin Hesabı</th>
            <th>İnstagram Hesabı</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
              
                <td><a href="@item.GithubUrl" target="_blank">@item.GithubUrl</a></td>
                <td><a href="@item.LinkedInUrl" target="_blank">@item.LinkedInUrl</a></td>
                <td><a href="@item.InstagramUrl" target="_blank">@item.InstagramUrl</a></td> 
                <td>@(item.IsActive ? "Aktif" : "Pasif")</td>
                <td>
                    <button onclick="deleteSocialMedia(@item.SocialMediaId)" class="btn btn-outline-danger">Sil</button>
                    <a href="/SocialMedia/UpdateSocialMedia/@item.SocialMediaId" class="btn btn-outline-info">Güncelle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="/SocialMedia/AddSocialMedia" class="btn btn-outline-info">Yeni Sosyal Medya Ekle</a>
<script>
        function deleteSocialMedia(id)
        {
                Swal.fire({
      title: "Silmek istediğinize emin misiniz?",
      text: "Bu işlemi geri alamazsınız",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet ,Sil!",
      cancelButtonText:"İptal!"
    }).then((result) => {
      if (result.isConfirmed) {
          window.location.href ="/SocialMedia/DeleteSocialMedia/"+id;
      }
    });
        }
</script>