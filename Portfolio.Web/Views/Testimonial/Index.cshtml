@model List<Testimonial>
@{
    ViewData["Title"] = "Referanslarım";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<h2>Referanslarım</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>İsim</th>
            <th>Başlık</th>
            <th>Resim Url</th>
            <th>Yorum</th>
            <th>Değerlendirme (1-5)</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                count++;
                <tr>
                    <td>@count</td>
                    <td>@item.Name</td>
                    <td>@item.Title</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="Image" width="60" height="60" class="rounded-circle" />
                        }
                    </td>
                    <td>@item.Comment</td>
                    <td>@item.Review</td>
                    <td>
                        <button onclick="deleteTestimonial(@item.TestimonialId)" class="btn btn-outline-danger">Sil</button>
                        <a href="/Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-outline-info">Güncelle</a>
                    </td>
                </tr>
            }
        }
        
    </tbody>
</table>
<a href="/Testimonial/AddTestimonial" class="btn btn-outline-info">Yeni Referans Ekle</a>
<script>
        function deleteTestimonial(id)
        {
                Swal.fire({
      title: "Silmek istediğinize emin misiniz?",
      text: "Bu işlemi geri alamazsınız",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet ,Sil!",
      cancelButtonText:"İptal!"
    }).then((result) => {
      if (result.isConfirmed) {
          window.location.href ="/Testimonial/DeleteTestimonial/"+id;
      }
    });
        }
</script>