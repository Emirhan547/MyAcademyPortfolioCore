@model Skill
@{
    ViewData["Title"] = "Yetenek Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}
<h2>Yeni Yetenek Ekle</h2>

<form asp-action="AddSkill" method="post">
    <div class="mb-3">
        <label>Yetenek Adı</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Yüzde (%)</label>
        <input asp-for="Percentage" type="number" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>

