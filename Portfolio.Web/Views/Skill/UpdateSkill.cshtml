@model Skill
@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h2>Yetenek Güncelle</h2>

<form asp-action="UpdateSkill" method="post">
    <input type="hidden" asp-for="SkillId" />

    <div class="mb-3">
        <label>Yetenek Adı</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Yüzde (%)</label>
        <input asp-for="Percentage" type="number" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
</form>

