@model List<About>
@{
    ViewData["Title"] = "Hakkımda";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

@{
    int count = 0;
}

<h2>Hakkımda Bilgileri</h2>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Resim</th>         
            <th>Doğum Tarihi</th>   
            <th>Telefon</th>
            <th>Şehir</th>
            <th>Mezuniyet</th>
            <th>Email</th>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>Durum</th>
            
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td><img src="@item.ImageUrl" alt="Resim" width="50" /></td>
                <td>@item.BirthDate.ToShortDateString()</td>
                <td>@item.PhoneNumber</td>
                <td>@item.City</td>
                <td>@item.Graduation</td>
                <td>@item.Email</td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@(item.IsAvailable ? "Uygun" : "Uygun Değil")</td>
               
                <td>
                    <button onclick="deleteAbout(@item.AboutId)" class="btn btn-outline-danger">Sil</button>
                    <a href="/About/UpdateAbout/@item.AboutId" class="btn btn-outline-info">Güncelle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="/About/AddAbout" class="btn btn-outline-info">Yeni Hakkında Ekle</a>
<script>
        function deleteAbout(id)
        {
                Swal.fire({
      title: "Silmek istediğinize emin misiniz?",
      text: "Bu işlemi geri alamazsınız",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet ,Sil!",
      cancelButtonText:"İptal!"
    }).then((result) => {
      if (result.isConfirmed) {
          window.location.href ="/About/DeleteAbout/"+id;
      }
    });
        }
</script>