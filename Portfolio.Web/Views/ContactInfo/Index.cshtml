@model List<ContactInfo>
@{
    ViewData["Title"] = "İletişim";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<h2>İletişim Bilgileri</h2>



<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Adres</th>
            <th>Telefon</th>
            <th>Email</th>
            <th>Harita</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.Address</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Email</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.MapUrl))
                    {
                        <a href="@item.MapUrl" target="_blank">Haritada Gör</a>
                    }
                </td>
                <td>
                    <button onclick="deleteContactInfo(@item.ContactInfoId)" class="btn btn-outline-danger">Sil</button>
                    <a href="/ContactInfo/UpdateContactInfo/@item.ContactInfoId" class="btn btn-outline-info">Güncelle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
 <a href="/ContactInfo/AddContactInfo" class="btn btn-outline-info">Yeni İletişim Ekle</a>

<script>
        function deleteContactInfo(id)
        {
                Swal.fire({
      title: "Silmek istediğinize emin misiniz?",
      text: "Bu işlemi geri alamazsınız",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet ,Sil!",
      cancelButtonText:"İptal!"
    }).then((result) => {
      if (result.isConfirmed) {
          window.location.href ="/ContactInfo/DeleteContactInfo/"+id;
      }
    });
        }
</script>