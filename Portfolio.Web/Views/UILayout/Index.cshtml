    <script src="~/Kelly-1.0.0/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/Kelly-1.0.0/assets/vendor/aos/aos.js"></script>
    <script src="~/Kelly-1.0.0/assets/vendor/waypoints/noframework.waypoints.js"></script>
