                    <li><a href="#">Ana Sayfa</a></li>
                    <li><a href="#about">Hakkımda</a></li>
                    <li><a href="#resume">Eğitim</a></li>
                    <li><a href="#skills">Yeteneklerim</a></li>
                    <li><a href="#stats">İstatistik</a></li>
                    <li><a href="#testimonials">Referanslarım</a></li>
                    <li><a href="#portfolio">Projelerim</a></li>
                    <li><a href="#contact">İletişim</a></li>
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

            @await Component.InvokeAsync("_DefaultSocialMediaComponent")
            
        </div>
    </header>

    <main class="main">

        @RenderBody()
    </main>

    <footer id="footer" class="footer light-background">

        <div class="container">
            <div class="copyright text-center">
                <p>© 2025 <strong class="px-1 sitename">Emirhan Hacıoğlu</strong> | Tüm Hakları Saklıdır.</p>
            </div>
        </div>

    </footer>


    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
