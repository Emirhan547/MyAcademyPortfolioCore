@model Banner

<section id="hero" class="hero section">

    <img src="@(Model?.CoverImageUrl ?? "/images/default.jpg")" alt="@Model?.Title" data-aos="fade-in">

    <div class="container text-center" data-aos="zoom-out" data-aos-delay="100">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2>@Model?.NameUserName</h2>
                <p>@Model?.Title</p>
                
            </div>
        </div>
    </div>

</section>
