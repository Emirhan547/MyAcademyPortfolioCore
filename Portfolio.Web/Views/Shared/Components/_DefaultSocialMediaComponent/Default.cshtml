@model List<SocialMedia>

<div class="header-social-links">
    @foreach (var item in Model)
    {
        <a href="@item.InstagramUrl" target="_blank" class="instagram"><i class="bi bi-instagram"></i></a>
        <a href="@item.LinkedInUrl" target="_blank" class="linkedin"><i class="bi bi-linkedin"></i></a>
        <a href="@item.GithubUrl" target="_blank" class="github"><i class="bi bi-github"></i></a>
    }
</div>
