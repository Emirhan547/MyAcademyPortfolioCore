@model About
@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
<section id="resume" class="resume section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Özgeçmiş</h2>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row">

            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                <h3 class="resume-title">Bilgi</h3>

                <div class="resume-item pb-0">
                    <h4>Emirhan Hacıoğlu</h4>
                    <p><em>@Model.Title</em></p>
                    <ul>
                        <li>@Model.City</li>
                        <li>@Model.PhoneNumber</li>
                        <li>@Model.Email</li>
                    </ul>
                </div><!-- Edn Resume Item -->
                @await Component.InvokeAsync("_DefaultEducationComponent")
            </div>

            @await Component.InvokeAsync("_DefaultExperienceComponent")

        </div>

    </div>

</section>