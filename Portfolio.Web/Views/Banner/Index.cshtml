@model List<Banner>
@{
    ViewData["Title"] = "Öne Çıkanlar";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<h2>Öne Çıkan Alan Listesi</h2>


<table class="table table-bordered table-striped">
   
        <tr>
            <th>#</th>
            <th>Kapak Resmi</th>
            <th>Kullanıcı Adı</th>
            <th>Başlık</th>
            <th>İşlemler</th>
        </tr>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.CoverImageUrl</td>
                <td>@item.NameUserName</td>
                <td>@item.Title</td>
                <td>
                <button onclick="deleteBanner(@item.BannerId)" class="btn btn-outline-danger">Sil</button>
                    <a href="/Banner/UpdateBanner/@item.BannerId" class="btn btn-outline-info">Güncelle</a>
                </td>
            </tr>
        }
    
</table>
<a href="/Banner/AddBanner" class="btn btn-outline-info">Yeni Öne Çıkan Ekle</a>

<script>
        function deleteBanner(id)
        {
                Swal.fire({
      title: "Silmek istediğinize emin misiniz?",
      text: "Bu işlemi geri alamazsınız",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet ,Sil!",
      cancelButtonText:"İptal!"
    }).then((result) => {
      if (result.isConfirmed) {
          window.location.href ="/Banner/DeleteBanner/"+id;
      }
    });
        }
</script>