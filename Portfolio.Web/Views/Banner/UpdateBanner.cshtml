@model Banner
@{
    ViewData["Title"] = "Öne Çıkanlar Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h2>Öne Çıkanlar Güncelle</h2>

<form asp-action="UpdateBanner" method="post">
    <input type="hidden" asp-for="BannerId" />

    <div class="form-group">
        <label>Kapak Resmi URL</label>
        <input asp-for="CoverImageUrl" class="form-control" />
    </div>
    <div class="form-group">
        <label>Kullanıcı Adı</label>
        <input asp-for="NameUserName" class="form-control" />
    </div>
    <div class="form-group">
        <label>Başlık</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
</form>
