@model Banner
@{
    ViewData["Title"] = "Öne Çıkanlar Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h2>Yeni Banner Ekle</h2>

<form asp-action="AddBanner" method="post">
    <div class="form-group">
        <label>Kapak Resmi URL</label>
        <input asp-for="CoverImageUrl" class="form-control" />
    </div>
    <div class="form-group">
        <label>Kullanıcı Adı</label>
        <input asp-for="NameUserName" class="form-control" />
    </div>
    <div class="form-group">
        <label>Başlık</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success mt-3">Kaydet</button>
   
</form>

