@model List<UserMessage>
@{
    ViewData["Title"] = "Kullanıcı Mesajları";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<h2>📩 Gelen Mesajlar</h2>

<div>
    <a href="@Url.Action("Index", new { filter = "" })" class="btn btn-secondary">Tümü</a>
    <a href="@Url.Action("Index", new { filter = "unread" })" class="btn btn-danger">Okunmamış</a>
    <a href="@Url.Action("Index", new { filter = "read" })" class="btn btn-success">Okunmuş</a>
</div>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Gönderen</th>
            <th>Email</th>
            <th>Konu</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var msg in Model)
        {
            <tr class="@(msg.IsRead ? "table-success" : "table-danger")">
                <td>@msg.Name</td>
                <td>@msg.Email</td>
                <td>@msg.Subject</td>
                <td>@(msg.IsRead ? "Okundu" : "Okunmadı")</td>
                <td>
                    <a href="@Url.Action("Details", "UserMessage", new { id = msg.UserMessageId })" class="btn btn-info btn-sm">Mesajı Aç</a>
                    <a href="@Url.Action("DeleteMessage", "UserMessage", new { id = msg.UserMessageId })" class="btn btn-danger btn-sm" onclick="return confirm('Silmek istediğine emin misin?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
        function deleteMessage(id)
        {
                Swal.fire({
      title: "Silmek istediğinize emin misiniz?",
      text: "Bu işlemi geri alamazsınız",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet ,Sil!",
      cancelButtonText:"İptal!"
    }).then((result) => {
      if (result.isConfirmed) {
          window.location.href ="/UserMessage/DeleteMessage/"+id;
      }
    });
        }
</script>

