@model List<Education>    
@{
    ViewData["Title"] = "Eğitim";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<h2 class="mb-3">Eğitimler</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Okul</th>
            <th>Bölüm</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.SchoolName</td>
                <td>@item.Department</td>
                <td>@item.StartYear</td>
                <td>@item.EndYear</td>
                <td>@item.Description</td>
                <td>
                    <button onclick="deleteEducation(@item.EducationId)" class="btn btn-outline-danger">Sil</button>
                    <a href="/Education/UpdateEducation/@item.EducationId" class="btn btn-outline-info">Güncelle</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="/Education/AddEducation" class="btn btn-outline-info">Yeni Eğitim Ekle</a>

<script>
        function deleteEducation(id)
        {
                Swal.fire({
      title: "Silmek istediğinize emin misiniz?",
      text: "Bu işlemi geri alamazsınız",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet ,Sil!",
      cancelButtonText:"İptal!"
    }).then((result) => {
      if (result.isConfirmed) {
          window.location.href ="/Education/DeleteEducation/"+id;
      }
    });
        }
</script>